supervisor=supervise-daemon

# config written to by scxcli
if [ -f /etc/default/scx ]; then
    . /etc/default/scx
fi

name="scx service"
description="Service for sched_ext schedulers"
command="${SCX_SCHEDULER_OVERRIDE:-$SCX_SCHEDULER}"
command_args="${SCX_FLAGS_OVERRIDE:-$SCX_FLAGS}"
