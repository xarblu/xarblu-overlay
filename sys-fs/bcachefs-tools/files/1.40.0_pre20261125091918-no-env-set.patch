From 220065a7fcb5aeb38c56f66e2337f584bc079081 Mon Sep 17 00:00:00 2001
From: Xarblu <xarblu@protonmail.com>
Date: Wed, 25 Nov 2026 20:01:23 +0100
Subject: [PATCH] don't use --env-set

Signed-off-by: Xarblu <xarblu@protonmail.com>
---
 fs/Makefile | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/fs/Makefile b/fs/Makefile
index 618dd3393..fc8284753 100644
--- a/fs/Makefile
+++ b/fs/Makefile
@@ -18,7 +18,8 @@ CONFIG_BCACHEFS_FS :=
 bcachefs-prebuilt := y
 endif
 # The module's version, in its .modinfo: init/module.rs
-RUSTFLAGS_mod.o += --cfg bch_version -Zunstable-options --env-set BCACHEFS_VERSION=$(bcachefs-version)
+RUSTFLAGS_mod.o += --cfg bch_version
+export BCACHEFS_VERSION := $(bcachefs-version)
 else
 $(warning bcachefs: no version in $(src)/version.h - the module will carry none, and we're not looking for a prebuilt one (version.h is staged by bcachefs-tools 'make install_dkms'; a hand-copied kernel fs/bcachefs/ tree lacks it))
 endif
-- 
2.56.1

