From bc75e71b3b3440e26028045c4fa8ff63cfebf8fc Mon Sep 17 00:00:00 2001
From: flightlessmango <flightlessmangoyt@gmail.com>
Date: Thu, 26 Nov 2026 00:40:08 +0100
Subject: [PATCH] classic: Fix libc++ atomic shared_ptr compatibility

Resolves #2231
---
 src/overlay_params.cpp | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/overlay_params.cpp b/src/overlay_params.cpp
index 65bc4e83db..0f194bdd63 100644
--- a/src/overlay_params.cpp
+++ b/src/overlay_params.cpp
@@ -49,7 +49,7 @@ std::unique_ptr<fpsMetrics> fpsmetrics;
 std::mutex config_mtx;
 std::condition_variable config_cv;
 bool config_ready = false;
-static std::atomic<std::shared_ptr<overlay_params>> g_params;
+static std::shared_ptr<overlay_params> g_params;
 std::unique_ptr<GPUS> gpus = nullptr;
 std::shared_ptr<fpsLimiter> fps_limiter;
 
@@ -1219,9 +1219,9 @@ parse_overlay_config(struct overlay_params *params,
       config_cv.notify_one();
    }
 
-   auto prev_params = g_params.load(std::memory_order_acquire);
+   auto prev_params = std::atomic_load_explicit(&g_params, std::memory_order_acquire);
    auto snapshot = std::make_shared<overlay_params>(*params);
-   g_params.store(std::move(snapshot), std::memory_order_release);
+   std::atomic_store_explicit(&g_params, std::move(snapshot), std::memory_order_release);
 
    // a preset switch keeps the limit picked with toggle_fps_limit, unless the preset changes fps_limit
    size_t fps_limits_idx = 0;
@@ -1245,7 +1245,7 @@ parse_overlay_config(struct overlay_params *params,
 
 std::shared_ptr<overlay_params> get_params() {
     for (;;) {
-        auto p = g_params.load(std::memory_order_acquire);
+        auto p = std::atomic_load_explicit(&g_params, std::memory_order_acquire);
         if (p) return p;
         std::this_thread::sleep_for(std::chrono::milliseconds(25));
     }
